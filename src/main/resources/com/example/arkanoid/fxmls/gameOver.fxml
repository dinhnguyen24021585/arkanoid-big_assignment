<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="gameOver-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arkanoid.Controllers.GameOverController">
   <children>
      <Button id="btnReplay" fx:id="btnReplay" layoutX="135.0" layoutY="469.0" mnemonicParsing="false" onAction="#handleReplay" prefHeight="83.0" prefWidth="131.0" styleClass="image-button" stylesheets="@styles.css" />
      <Button id="btnQuitToMenu" fx:id="btnQuitToMenu" layoutX="544.0" layoutY="469.0" mnemonicParsing="false" onAction="#handleQuitToMenu" prefHeight="83.0" prefWidth="119.0" styleClass="image-button" stylesheets="@styles.css" />
      <VBox fx:id="scoreContainer" layoutX="212.0" layoutY="312.0" prefHeight="150.0" prefWidth="379.0" styleClass="vbox-nen" stylesheets="@styles.css">
         <children>
            <Label fx:id="scoreLabel" prefHeight="88.0" prefWidth="316.0" text="SCORE">
               <font>
                  <Font name="Tahoma Bold" size="24.0" />
               </font>
               <textFill>
                  <LinearGradient endX="0.05047318536776473" endY="1.0" startX="0.5804415674239679" startY="0.6782334505195498">
                     <stops>
                        <Stop>
                           <color>
                              <Color red="1.0" green="1.0" blue="1.0" opacity="0.8600000143051147" />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color red="0.5899999737739563" green="1.0" blue="0.9794999957084656" opacity="0.7900000214576721" />
                           </color>
                        </Stop>
                     </stops>
                  </LinearGradient>
               </textFill>
            </Label>
            <Label fx:id="highScoreLabel" prefHeight="37.0" prefWidth="295.0" text="HIGH SCORE">
               <font>
                  <Font name="Tahoma Bold" size="24.0" />
               </font>
               <textFill>
                  <LinearGradient endX="0.05047318536776473" endY="1.0" startX="0.5804415674239679" startY="0.6782334505195498">
                     <stops>
                        <Stop>
                           <color>
                              <Color red="1.0" green="0.9969135522842407" blue="0.9985596537590027" opacity="0.8600000143051147" />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color red="0.5899999737739563" green="1.0" blue="0.9794999957084656" opacity="0.7900000214576721" />
                           </color>
                        </Stop>
                     </stops>
                  </LinearGradient>
               </textFill>
            </Label>
         </children>
         <padding>
            <Insets left="30.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
